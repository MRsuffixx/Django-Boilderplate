# Application
APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
APP_NAME=Django Foundation
SITE_NAME=Django Foundation
SITE_URL=http://localhost:8000
SUPPORT_EMAIL=support@localhost
DEFAULT_FROM_EMAIL=Django Foundation <noreply@localhost>
DEFAULT_LANGUAGE=en
TIME_ZONE=UTC

# Database: SQLite is the zero-infrastructure default.
DATABASE_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
SQLITE_TIMEOUT_SECONDS=20
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=true

# PostgreSQL alternative: set DATABASE_ENGINE=postgresql and install .[postgres].
# Use DATABASE_URL, or leave it empty and configure the DB_* values.
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis is optional. The URL is ignored while REDIS_ENABLED=false.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Celery is optional. Task dispatch runs synchronously while disabled.
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Email: console is the zero-infrastructure default. Select SMTP for Mailpit/providers.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false

# Browser security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173
SECURE_SSL_REDIRECT=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'

# Authentication / crypto
TOTP_ENCRYPTION_KEY=
API_KEY_PEPPER=
API_KEY_AVAILABLE_SCOPES=profile.read,profile.write,notifications.read,notifications.write
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_TIMEOUT_SECONDS=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
LOGIN_MAX_BACKOFF_SECONDS=3600

# DRF throttling
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=10/minute
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_EMAIL_VERIFICATION=5/hour
THROTTLE_API_KEY=600/hour

# Optional modules
ENABLE_NOTIFICATIONS=true
ENABLE_API_KEYS=true
ENABLE_TWO_FACTOR=true
ENABLE_WEBHOOKS=false
ENABLE_OPENAPI=true
ENABLE_OPENAPI_IN_PRODUCTION=false
ENABLE_SENTRY=false

# Storage (local or s3)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=true

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Retention / cleanup (days; zero disables destructive retention)
SESSION_RETENTION_DAYS=30
TOKEN_RETENTION_DAYS=7
NOTIFICATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=0
FILE_RETENTION_DAYS=7
WEBHOOK_RETENTION_DAYS=30
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_PIXELS=25000000
